# --- Server (Admin SDK) — KHÔNG thêm tiền tố NEXT_PUBLIC_ ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Dán nguyên private_key, giữ dấu ngoặc kép, các dòng nối bằng \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Số ngày giữ request (dùng cho TTL policy trên field expireAt)
REQUEST_RETENTION_DAYS=7

# --- Client (Web SDK) — Firebase Console > Project settings > Your apps ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
